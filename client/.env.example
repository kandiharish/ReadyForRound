# Copy this file to .env and fill in your values.
# Supabase -> Project Settings -> API Keys
VITE_SUPABASE_URL=
# PUBLISHABLE key only (safe for the browser). Never put the secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Online only: the backend's address, e.g. https://readyforround-api.onrender.com
# Leave empty on your laptop.
VITE_API_URL=

# Shown on the Privacy and Terms pages as the contact for data questions
VITE_CONTACT_EMAIL=
