# Copy this file to .env and fill in your values. Never commit .env.

PORT=5000
CLIENT_URL=http://localhost:5180

# Which AI to use: ollama (local laptop) | groq (online) | openrouter (online)
LLM_PROVIDER=ollama
# Backup AI if the main one fails: ollama | groq | openrouter | none
LLM_FALLBACK_PROVIDER=none
# Which AI grades answers and writes the report (a bigger model gives more accurate feedback)
REPORT_LLM_PROVIDER=groq

# Ollama (local, free, no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# Groq (free account at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REPORT_MODEL=openai/gpt-oss-120b
# Speech-to-text for spoken answers (needs GROQ_API_KEY, even when LLM_PROVIDER=ollama)
GROQ_STT_MODEL=whisper-large-v3-turbo

# OpenRouter (optional backup, https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Supabase (free project at https://supabase.com) -> Project Settings -> API Keys
SUPABASE_URL=
# SECRET key: full access, server only. Never put this in the client.
SUPABASE_SECRET_KEY=

# Feedback button: emails go to FEEDBACK_TO_EMAIL via Resend (free account at https://resend.com -> API Keys)
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
